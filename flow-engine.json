{
    "version": "1.0",
    "context": {
        "type": "composer",
        "autoload": "vendor/autoload.php"
    },
    "scan": {
        "include": [
            "src"
        ],
        "exclude": [
            "vendor",
            "tests"
        ],
        "extensions": [
            "php"
        ]
    },
    "architecture": {
        "layers": {
            "AI": ["FlowEngine\\AI\\"],
            "Bootstrap": ["FlowEngine\\Bootstrap\\"],
            "Console": ["FlowEngine\\Console\\"],
            "Cache": ["FlowEngine\\Cache\\"],
            "Diagram": ["FlowEngine\\Diagram\\"]
        }
    }
}